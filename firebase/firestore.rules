rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if we're in emulator mode
    // In emulator, request.auth is typically null, so we allow operations
    // In production, we require proper authentication
    function isEmulatorMode() {
      // Check if we're in emulator by checking for null auth
      // In production, this will be false and require proper auth
      return request.auth == null;
    }
    
    // Generic Financial Accounts Collection (supports prefixes like dev_financialAccounts)
    match /{collectionName}/{accountId} {
      // Helper function to validate collection name
      function isFinancialAccountsCollection() {
        return collectionName == 'financialAccounts' || 
               collectionName.matches('.*_financialAccounts');
      }

      // Only apply these rules if it is a financial accounts collection
      // otherwise fall through to other rules
      
      // Allow all operations in emulator mode (for development)
      allow read, write, create, update, delete: if isFinancialAccountsCollection() && isEmulatorMode();
      
      // Production rules: Users can only read/write their own accounts
      allow read: if isFinancialAccountsCollection() && 
                    request.auth != null && 
                    request.auth.uid == resource.data.userId;
      allow write, update, delete: if isFinancialAccountsCollection() && 
                                      request.auth != null && 
                                      request.auth.uid == resource.data.userId;
      allow create: if isFinancialAccountsCollection() && 
                      request.auth != null && 
                      request.auth.uid == request.resource.data.userId;
      
      // Payment Periods subcollection
      match /paymentPeriods/{periodId} {
        // Allow all operations in emulator mode
        allow read, write, create, update, delete: if isEmulatorMode();
        
        // Production rules: Check parent account's userId matches auth.uid
        allow read, write, create, update, delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/$(collectionName)/$(accountId)).data.userId;
      }
    }
    
    // Default rule: deny all access
    // Override with specific rules for your collections
    match /{document=**} {
      // Allow all in emulator mode for development
      allow read, write: if isEmulatorMode();
      // Deny all in production
      allow read, write: if false;
    }
  }
}



