# Terraform working directory (provider binaries and modules cache)
.terraform/

# Variable files with secrets (keep example files like terraform.tfvars.example)
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files (user-specific)
.terraformrc
terraform.rc

# Note: .terraform.lock.hcl SHOULD be committed (ensures consistent provider versions)
