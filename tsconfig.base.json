{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@rates/firebase-client": ["./packages/firebase-client/src/index.ts"],
      "@rates/ui-theme": ["./packages/ui-theme/src/index.ts"],
      "@rates/vertex-ai-client": ["./packages/vertex-ai-client/src/index.ts"]
    }
  }
}
