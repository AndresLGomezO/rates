# Firebase Configuration (shared with root)
# These are inherited from the root env.example or can be set here

# Auth App Configuration
# URL of the auth-app service
VITE_AUTH_APP_URL=http://localhost:5175

# AI Service App Configuration
# URL of the ai-service app
VITE_AI_SERVICE_URL=http://localhost:5050

# Nonce Security (shared secret for app-to-app communication)
# Must match VITE_NONCE_SECRET in auth-app EXACTLY
# Must be at least 16 characters. Use a strong random string.
# Generate with: openssl rand -hex 32
VITE_NONCE_SECRET=your-secret-key-minimum-16-chars-long

# IMPORTANT: Before running this app:
# 1. Ensure Firebase emulators are running: pnpm firebase:emulators
# 2. Ensure auth-app is running: pnpm --filter auth-app dev
# 3. Set VITE_NONCE_SECRET to match auth-app's VITE_NONCE_SECRET

# Debug Indicator
# Set to 'false' to hide the build info debug indicator in production
# Default: enabled (shows build date, time, and build number)
# VITE_SHOW_DEBUG_INDICATOR=false