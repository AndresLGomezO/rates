# Firebase Configuration (use demo values for emulator)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo
VITE_FIREBASE_MEASUREMENT_ID=G-DEMO123

# Use emulator in local dev (auth emulator)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Emulator Ports (must match firebase.json and docker-compose.yml)
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199
VITE_FIREBASE_EMULATOR_FUNCTIONS_PORT=5001

# Redirect handling
# Default return URL (main app port)
VITE_DEFAULT_RETURN_URL=http://127.0.0.1:5174
VITE_ALLOWED_REDIRECTS=http://127.0.0.1:5174,http://localhost:5174,https://app.example.com

# Cookie handling (non-HttpOnly, SameSite applied)
VITE_ENABLE_AUTH_COOKIE=true
VITE_AUTH_COOKIE_NAME=auth_app_token
VITE_AUTH_COOKIE_MAX_AGE=3600
VITE_AUTH_COOKIE_DOMAIN=
VITE_AUTH_COOKIE_SAMESITE=Lax

# Firebase Admin SDK Configuration (for server-side token validation)
# For emulator mode, no credentials needed - leave these empty
# For production, you need one of the following:

# Option 1: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json# Option 2: Service account JSON as environment variable (base64 encoded recommended)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'# Option 3: Use Application Default Credentials (ADC)
# This works automatically in Google Cloud environments (Cloud Run, App Engine, etc.)
# No configuration needed if running in GCP