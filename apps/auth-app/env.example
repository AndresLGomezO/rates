VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Use emulator in local dev (auth emulator)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099

# Redirect handling
VITE_DEFAULT_RETURN_URL=http://localhost:5173
VITE_ALLOWED_REDIRECTS=http://localhost:5173,https://app.example.com

# Cookie handling (non-HttpOnly, SameSite applied)
VITE_ENABLE_AUTH_COOKIE=true
VITE_AUTH_COOKIE_NAME=auth_app_token
VITE_AUTH_COOKIE_MAX_AGE=3600
VITE_AUTH_COOKIE_DOMAIN=
VITE_AUTH_COOKIE_SAMESITE=Lax

# Nonce security (shared secret for app-to-app communication)
# Must be at least 16 characters. Use a strong random string.
# This same secret must be configured in all apps that use auth-app.
VITE_NONCE_SECRET=your-secret-key-minimum-16-chars-long
VITE_NONCE_MAX_AGE_MS=300000

