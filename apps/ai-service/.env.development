ENV=development
PORT=3001
GCP_PROJECT_ID=demo-project
VERTEX_AI_PROJECT_ID=rates-production

# Mock Vertex AI
VERTEX_AI_MOCK=true
VERTEX_AI_MOCK_DELAY=500

# Firebase Emulator
FIRESTORE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Skip IAM auth locally
SKIP_AUTH_VALIDATION=true

# Collection prefix
FIRESTORE_COLLECTION_PREFIX=dev_

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MIN=60
RATE_LIMIT_TOKENS_PER_DAY=1000000
