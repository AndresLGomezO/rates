# Firebase Emulators Dockerfile
FROM node:20-slim

# Install Java 21 (required for Firestore emulator) and wget (for healthcheck)
# Firebase tools requires Java 21 or above
# Using Adoptium (Temurin) for Java 21 as it's not in Debian Bookworm repos
RUN apt-get update && \
    apt-get install -y wget curl gnupg && \
    mkdir -p /etc/apt/keyrings && \
    wget -O - https://packages.adoptium.net/artifactory/api/gpg/key/public | tee /etc/apt/keyrings/adoptium.asc && \
    echo "deb [signed-by=/etc/apt/keyrings/adoptium.asc] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" | tee /etc/apt/sources.list.d/adoptium.list && \
    apt-get update && \
    apt-get install -y temurin-21-jre && \
    rm -rf /var/lib/apt/lists/*

# Install Firebase CLI globally
RUN npm install -g firebase-tools

# Set working directory
WORKDIR /app

# Copy Firebase configuration
# Firebase CLI expects firebase.json in the working directory
COPY firebase/firebase.json ./
COPY firebase/firestore.rules ./firestore.rules
COPY firebase/firestore.indexes.json ./firestore.indexes.json
COPY firebase/storage.rules ./storage.rules
COPY .firebaserc ./

# Create directory for emulator data persistence
RUN mkdir -p /app/.firebase/emulators

# Expose emulator ports
# Auth: 9099, Firestore: 8080, Storage: 9199, Functions: 5001, UI: 4000
EXPOSE 4000 5001 8080 9099 9199

# Use a script to handle dynamic project ID
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Start emulators using entrypoint script
ENTRYPOINT ["/entrypoint.sh"]
