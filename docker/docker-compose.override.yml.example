# Example override file for local development
# Copy this to docker-compose.override.yml and customize as needed
# docker-compose.override.yml is automatically loaded by docker-compose
# Note: This file should be in the project root, not in docker/ directory

services:
  firebase-emulators:
    # Override ports if needed
    # ports:
    #   - "4001:4000"  # Use different host port
    environment:
      # Add custom environment variables
      - DEBUG=firebase:*
    # Mount additional volumes if needed
    # volumes:
    #   - ./custom-data:/app/custom-data
