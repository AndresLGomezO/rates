# Environment variables for Docker-based Firebase emulators
# Copy this to .env.docker and update as needed

# Firebase Project ID (used by emulators)
# Use "demo-" prefix to avoid production API calls and warnings
FIREBASE_PROJECT_ID=demo-default

# For your app to connect to Docker emulators, use these settings:
# VITE_FIREBASE_EMULATOR_HOST=localhost  (or the Docker service name if in same network)
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_MODE=emulator

# Emulator ports (matching docker-compose.yml)
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199
VITE_FIREBASE_EMULATOR_FUNCTIONS_PORT=5001

# Firebase Project Configuration (for your app)
# These are still needed for your app initialization
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=default
VITE_FIREBASE_STORAGE_BUCKET=default.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
