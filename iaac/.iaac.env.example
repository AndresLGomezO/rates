# Infrastructure as Code Configuration
# Copy this file to .iaac.env and fill in your values
# This is the ONLY file you need to modify

# =============================================================================
# GCP Authentication (Required for initial setup)
# =============================================================================
# Your GCP account email (used for initial authentication)
GCP_USER_EMAIL=your-email@example.com

# =============================================================================
# GitHub Configuration
# =============================================================================
GITHUB_OWNER=your-github-username
GITHUB_REPO=rates

# =============================================================================
# GCP Project Configuration
# =============================================================================
# Project IDs for each environment (create these in GCP Console first, or leave empty to create via Terraform)
# If empty, Terraform will attempt to create projects (requires billing account)
GCP_PROJECT_ID_DEV=
GCP_PROJECT_ID_STAGING=
GCP_PROJECT_ID_PROD=

# Billing Account ID (required if creating new projects)
# Find it in: https://console.cloud.google.com/billing
GCP_BILLING_ACCOUNT_ID=

# Organization ID (optional, for organization-level policies)
# Leave empty if not using GCP Organization
GCP_ORGANIZATION_ID=

# =============================================================================
# Region Configuration
# =============================================================================
GCP_REGION=us-central1

# =============================================================================
# Workload Identity Federation Configuration
# =============================================================================
# Pool and provider IDs (will be created if they don't exist)
WIF_POOL_ID=github-pool
WIF_PROVIDER_ID=github-provider

# =============================================================================
# Service Account Configuration
# =============================================================================
# Service account names for each environment
SA_NAME_DEV=github-ci-dev
SA_NAME_STAGING=github-ci-staging
SA_NAME_PROD=github-ci-prod

# =============================================================================
# Artifact Registry Configuration
# =============================================================================
# Repository names for each environment
AR_REPOSITORY_DEV=dev-rates
AR_REPOSITORY_STAGING=staging-rates
AR_REPOSITORY_PROD=rates

# =============================================================================
# Cloud Run Configuration
# =============================================================================
# Service names for each environment
CLOUD_RUN_SERVICE_APP_DEV=rates-app-dev
CLOUD_RUN_SERVICE_APP_STAGING=rates-app-staging
CLOUD_RUN_SERVICE_APP_PROD=rates-app

CLOUD_RUN_SERVICE_AUTH_APP_DEV=rates-auth-app-dev
CLOUD_RUN_SERVICE_AUTH_APP_STAGING=rates-auth-app-staging
CLOUD_RUN_SERVICE_AUTH_APP_PROD=rates-auth-app

# Cloud Run configuration
CLOUD_RUN_CPU=1
# Free-tier first default: Cloud Run Gen2 requires >= 512Mi
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_MIN_INSTANCES=0
# Free-tier first default (avoid surprise spend)
CLOUD_RUN_MAX_INSTANCES=3
CLOUD_RUN_CONCURRENCY=80

# =============================================================================
# Branch Configuration
# =============================================================================
# GitHub branches that trigger deployments to each environment
GITHUB_BRANCH_DEV=develop
GITHUB_BRANCH_STAGING=staging
GITHUB_BRANCH_PROD=main

# =============================================================================
# Terraform State Configuration (Optional)
# =============================================================================
# If using remote state, configure these:
# TF_STATE_BUCKET=
# TF_STATE_PREFIX=terraform/state

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# Enable/disable specific resources (true/false)
CREATE_PROJECTS=false
CREATE_CLOUD_RUN_SERVICES=true
ENABLE_APIS=true

# Only needed if Cloud Run runs as a DIFFERENT runtime service account than the deployer SA.
# Free-tier + least-privilege default is false.
GRANT_SERVICE_ACCOUNT_USER=false
