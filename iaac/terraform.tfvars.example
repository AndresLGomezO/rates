# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored - never commit secrets!

# ============================================================================
# Project Configuration
# ============================================================================

# Billing Account ID (format: XXXXXX-XXXXXX-XXXXXX)
# Required for new projects
# Find at: https://console.cloud.google.com/billing
billing_account_id = "YOUR_BILLING_ACCOUNT_ID"

# Administrator email
# Used for project owner assignment and initial IAM bindings
admin_email = "your-email@example.com"

# ============================================================================
# Application Configuration
# ============================================================================

# Application name (used for resource naming)
# Must be lowercase alphanumeric with hyphens
app_name = "your-app-name"

# Environment (dev, staging, prod)
environment = "dev"

# GCP Region
# Must support Cloud Run, Artifact Registry, and Firestore
region = "us-central1"

# Firestore location
# ⚠️ WARNING: Cannot be changed after database creation!
# Options: nam5 (multi-region US), eur3 (multi-region Europe), or single regions
firestore_location = "nam5"

# ============================================================================
# GitHub Actions / CI/CD Configuration
# ============================================================================

# GitHub repository in format 'owner/repo-name'
# Required for Workload Identity Federation and GitHub Actions automation
# Example: "myorg/myapp" or "username/myproject"
github_repo = "YOUR_GITHUB_OWNER/YOUR_REPO_NAME"

# List of GitHub environment names for deployment gates
# Each environment will be configured in WIF and GitHub Actions
github_environments = ["dev", "staging", "prod"]

# Enable automated GitHub Actions configuration
# When true: Creates secrets, variables, environments, and workflow files
# When false: Skips automation (WIF still configured for manual use)
# Default: true
configure_github_actions = true

# ============================================================================
# FREE TIER Configuration (DEFAULT: ENABLED)
# ============================================================================

# Restrict all resources to free tier configurations
# When true: Scale to zero, no PITR, no backups, no paid features
# When false: Allows paid features (requires explicit opt-in per feature)
# Default: true
enable_free_tier_only = true

# ============================================================================
# Cloud Run Configuration (FREE TIER DEFAULTS)
# ============================================================================

# Minimum instances (0 = scale to zero = FREE)
# Set to 1+ for always-on instances (PAID)
cloudrun_min_instances = 0

# Maximum instances (limit to control costs)
cloudrun_max_instances = 2

# Memory allocation
# Options: 128Mi, 256Mi, 512Mi, 1Gi, 2Gi, 4Gi, 8Gi
# Gen2 requires minimum 512Mi
cloudrun_memory = "512Mi"

# CPU allocation
# Options: 1, 2, 4, 6, 8
cloudrun_cpu = "1"

# ============================================================================
# Firestore Configuration (FREE TIER DEFAULTS)
# ============================================================================

# Enable Point-in-Time Recovery (PITR)
# 💰 PAID FEATURE: ~$0.10/GB/month
# Default: false (disabled for free tier)
enable_firestore_pitr = false

# Enable automated Firestore backups
# 💰 PAID FEATURE: Variable cost
# Default: false (disabled for free tier)
enable_firestore_backups = false

# Enable deletion protection
# FREE but may complicate teardown
# Default: false (easy dev cleanup)
enable_deletion_protection = false

# ============================================================================
# Identity Platform (Firebase Auth) Configuration
# ============================================================================

# Enable Multi-Factor Authentication (SMS-based)
# 💰 PAID FEATURE: 10 SMS/day free, then paid
# Default: false (disabled for free tier)
enable_mfa = false

# Enable Google Sign-In provider
# FREE feature - no additional cost
# Requires OAuth credentials (see below)
# Default: false
enable_google_signin = false

# Google OAuth 2.0 Client ID (for Google Sign-In)
# Required if enable_google_signin is true
# Create at: https://console.cloud.google.com/apis/credentials
# google_oauth_client_id = "YOUR_CLIENT_ID"

# Google OAuth 2.0 Client Secret (for Google Sign-In)
# ⚠️ SENSITIVE: Store in Secret Manager or use terraform.tfvars with .gitignore
# Required if enable_google_signin is true
# google_oauth_client_secret = "YOUR_CLIENT_SECRET"

# ============================================================================
# Firebase App Check Configuration
# ============================================================================

# Enable Firebase App Check for API abuse prevention
# FREE feature - no additional cost
# Requires reCAPTCHA setup (see below)
# Default: false
enable_app_check = false

# reCAPTCHA v3 Site Secret (for App Check)
# ⚠️ SENSITIVE: Store in Secret Manager or use terraform.tfvars with .gitignore
# Required if enable_app_check is true
# Get from: https://www.google.com/recaptcha/admin
# recaptcha_site_secret = "YOUR_SITE_SECRET"

# ============================================================================
# Artifact Registry Configuration
# ============================================================================

# Enable immutable container tags
# When enabled, prevents tag overwrites (increases storage usage)
# FREE TIER: Disabled by default (to minimize storage usage)
# Default: false
enable_immutable_tags = false

# ============================================================================
# Optional: Project ID (for existing projects)
# ============================================================================

# If you want to use an existing GCP project instead of creating a new one:
# project_id = "your-existing-project-id"

# If creating a new project, leave project_id as null (default)
# The project will be created with name: {app_name}-{environment}-{random}
