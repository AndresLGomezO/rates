# Firebase Configuration
# Copy this file to .env.local for local development
# or .env.development / .env.production for environment-specific configs

# Firebase Project Configuration
# For emulator mode, use demo values (these work with Firebase emulators)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo
VITE_FIREBASE_MEASUREMENT_ID=G-DEMO123

# Firebase Mode
# Set to 'emulator' to force emulator mode, 'live' to force live mode
# If not set, defaults to emulator in development, live in production
VITE_FIREBASE_MODE=

# Emulator Configuration
# Set to 'true' to use Firebase emulators (defaults to true in development)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Emulator Ports (must match firebase.json and docker-compose.yml)
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199
VITE_FIREBASE_EMULATOR_FUNCTIONS_PORT=5001






