# Firebase Configuration
# Copy this file to .env.local for local development
# or .env.development / .env.production for environment-specific configs

# Firebase Project Configuration
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Mode
# Set to 'emulator' to force emulator mode, 'live' to force live mode
# If not set, defaults to emulator in development, live in production
VITE_FIREBASE_MODE=

# Emulator Configuration
# Set to 'true' to use Firebase emulators (defaults to true in development)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=localhost

# Emulator Ports (defaults match firebase.json)
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199
VITE_FIREBASE_EMULATOR_FUNCTIONS_PORT=5001

